---
// Typography for rendered Markdown. The elements inside come from the Markdown
// renderer, not from this template, so they are styled through :global() under
// the scoped .prose root.
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: 40rem;
    font-size: 1.125rem;
    line-height: 1.7;
    overflow-wrap: break-word;
  }

  .prose > :global(* + *) {
    margin-top: 1.25em;
  }

  .prose :global(h2) {
    margin-top: 3rem;
    font-size: 1.625rem;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .prose :global(h3) {
    margin-top: 2.25rem;
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .prose :global(:is(h2, h3) + *) {
    margin-top: 0.875rem;
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration-thickness: 1px;
    transition: text-decoration-thickness var(--duration-fast) var(--ease-out);
  }

  .prose :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  .prose :global(li + li) {
    margin-top: 0.375em;
  }

  .prose :global(li::marker) {
    color: var(--color-muted);
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-accent);
    color: var(--color-muted);
  }

  .prose :global(blockquote > * + *) {
    margin-top: 0.75em;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .prose :global(:not(pre) > code) {
    padding: 0.125em 0.375em;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background: var(--color-surface);
  }

  /* A long line scrolls inside the block instead of widening the page. */
  .prose :global(pre) {
    padding: 1rem 1.25rem;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.875rem;
    line-height: 1.65;
    tab-size: 2;
  }

  .prose :global(pre code) {
    font-size: inherit;
  }
</style>
