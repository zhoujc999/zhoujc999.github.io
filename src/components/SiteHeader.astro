---
import { profile } from "../data/profile";

const sections = [
  { href: "#experience", label: "Experience" },
  { href: "#research", label: "Research" },
  { href: "#about", label: "About" },
];
---

<header class="site-header" data-header>
  <!-- One navigation for every width. DOM order matches the desktop reading order. -->
  <nav class="site-nav container" aria-label="Primary">
    <a class="site-nav__name" href="/">{profile.name}</a>
    <ul class="site-nav__links" role="list">
      {
        sections.map(({ href, label }) => (
          <li>
            <a class="site-nav__link" href={href} data-nav-link>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      class="site-nav__resume button button--quiet button--small"
      href={profile.links.resume}
      target="_blank"
      rel="noopener noreferrer"
    >
      Résumé<span class="visually-hidden"> (opens in a new tab)</span>
    </a>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  /* Below 48rem: name and Résumé on the first row, section links on the second. */
  .site-nav {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "name resume"
      "links links";
    align-items: center;
    gap: 0.375rem 1rem;
    padding-block: 0.875rem 0.5rem;
  }

  .site-nav__name {
    grid-area: name;
    justify-self: start;
    font-weight: 600;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .site-nav__resume {
    grid-area: resume;
  }

  .site-nav__links {
    display: flex;
    grid-area: links;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    display: inline-block;
    padding-block: 0.375rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current] {
    color: var(--color-ink);
  }

  .site-nav__link[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }

  @media (min-width: 48rem) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: color-mix(in srgb, var(--color-bg) 86%, transparent);
      backdrop-filter: saturate(1.4) blur(12px);
    }

    .site-nav {
      grid-template-columns: 1fr auto auto;
      grid-template-areas: "name links resume";
      column-gap: 2rem;
      height: var(--header-height);
      padding-block: 0;
    }

    .site-nav__links {
      gap: 2rem;
    }
  }

  @media print {
    .site-header {
      position: static;
    }
  }
</style>
