---
import { profile } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`Page not found | ${profile.name}`}
  description={`This page does not exist on ${profile.name}’s site.`}
  noindex
>
  <main class="not-found container" id="main-content">
    <p class="not-found__code mono">404</p>
    <h1 class="not-found__title">Page not found</h1>
    <p class="not-found__text">The page you were looking for does not exist or has moved.</p>
    <a class="button" href="/">Back to the homepage</a>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1rem;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: 4rem;
  }

  .not-found__code {
    color: var(--color-accent);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
  }

  .not-found__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .not-found__text {
    max-width: 32rem;
    margin-bottom: 1rem;
    color: var(--color-muted);
  }
</style>
