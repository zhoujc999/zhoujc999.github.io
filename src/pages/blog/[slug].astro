---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import PostMeta from "../../components/PostMeta.astro";
import Prose from "../../components/Prose.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getPosts, type Post } from "../../data/posts";
import { profile } from "../../data/profile";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | ${profile.name}`}
  description={post.data.description}
  ogType="article"
>
  <meta slot="head" property="article:published_time" content={post.data.date.toISOString()} />
  <SiteHeader />
  <main id="main-content">
    <article class="post container">
      <header class="post__header">
        <a class="post__back" href="/blog/"><span aria-hidden="true">←</span> Writing</a>
        <h1 class="section-title">{post.data.title}</h1>
        <PostMeta post={post} />
      </header>
      <Prose>
        <Content />
      </Prose>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .post {
    padding-block: clamp(2.5rem, 7vw, 5rem) var(--section-space);
  }

  .post__header {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 40rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .post__back {
    color: var(--color-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .post__back:hover {
    color: var(--color-ink);
  }
</style>
